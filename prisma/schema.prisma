generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  MEDICO
  PACIENTE
  ADMINISTRATIVO
  ENFERMERA
}

enum Especialidad {
  CLINICA_MEDICA
  PEDIATRIA
  TRAUMATOLOGIA
}

model User {
  id              String            @id @default(cuid())
  clerkId         String?           @unique
  email           String            @unique
  firstName       String?
  lastName        String?
  dni             String?           @unique
  phone           String?
  role            Role              @default(PACIENTE)
  isActive        Boolean           @default(true)
  matricula       String?           @unique
  especialidad    Especialidad?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  birthDate       DateTime?
  passwordHash    String?
  coberturaId     String?
  numeroAfiliado  String?
  MedicoCobertura MedicoCobertura[]
  MovimientoStock MovimientoStock[]
  Cobertura       Cobertura?        @relation(fields: [coberturaId], references: [id])

  // RF-01 (agenda médica): solo para usuarios con rol MEDICO.
  configuracionAgenda ConfiguracionAgenda?
  franjasHorarias     FranjaHoraria[]

  @@index([coberturaId])
}

// ---------------------------------------------------------------------------
// RF-01 — Agenda médica (US-25 a US-28).
//
// Las franjas se guardan con fecha concreta y una copia de la duración de turno
// vigente al guardarlas: así las fechas pasadas no cambian cuando el médico
// modifica su disponibilidad o su duración. Los turnos no se persisten; se
// calculan dividiendo cada franja por su `duracionTurnoMin`.
// ---------------------------------------------------------------------------

/// Duración de turno que definió el médico (US-25).
model ConfiguracionAgenda {
  medicoId         String   @id
  medico           User     @relation(fields: [medicoId], references: [id])
  duracionTurnoMin Int
  updatedAt        DateTime @updatedAt
}

/// Bloque de atención de un médico en un día concreto (US-26 y US-28).
model FranjaHoraria {
  id               String   @id @default(cuid())
  medicoId         String
  medico           User     @relation(fields: [medicoId], references: [id])
  /// Día calendario, sin hora.
  fecha            DateTime @db.Date
  /// Minutos desde las 00:00, hora de Argentina.
  inicioMin        Int
  finMin           Int
  /// Copia de la duración vigente al guardar la franja.
  duracionTurnoMin Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([medicoId, fecha])
}

// ---------------------------------------------------------------------------
// Modelos traídos de Neon con `prisma db pull` (RF-05b coberturas y RF-04a
// stock, de otros grupos). Están acá para que un `db push` desde esta rama no
// los borre. Al mergear con las ramas de esos grupos, conservar su versión.
// ---------------------------------------------------------------------------

model Cobertura {
  id                String            @id
  nombre            String
  nombreNormalizado String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  MedicoCobertura   MedicoCobertura[]
  User              User[]
}

model MedicoCobertura {
  id          String    @id
  medicoId    String
  coberturaId String
  createdAt   DateTime  @default(now())
  Cobertura   Cobertura @relation(fields: [coberturaId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  @@unique([medicoId, coberturaId])
  @@index([coberturaId])
}

model MovimientoStock {
  id            String         @id
  vacunaId      String
  tipo          TipoMovimiento
  cantidad      Int
  motivo        MotivoEgreso?
  motivoDetalle String?
  realizadoPor  String
  createdAt     DateTime       @default(now())
  User          User           @relation(fields: [realizadoPor], references: [id])
  Vacuna        Vacuna         @relation(fields: [vacunaId], references: [id], onDelete: Cascade)

  @@index([vacunaId, createdAt])
}

model Vacuna {
  id              String            @id
  nombre          String            @unique
  stockActual     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  MovimientoStock MovimientoStock[]
}

enum MotivoEgreso {
  VENCIMIENTO
  ROTURA_PERDIDA
  CORRECCION_CARGA
  OTRO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}
