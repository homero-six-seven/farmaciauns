generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  MEDICO
  PACIENTE
  ADMINISTRATIVO
  ENFERMERA
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?  @unique
  firstName String?
  lastName  String?
  role      Role     @default(PACIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
